{
  "mcpServers": {
    "relay": {
      "command": "bun",
      "args": ["${CLAUDE_PLUGIN_ROOT}/hooks-handlers/relay-stdio.ts"],
      "env": {
        "RELAY_HUB": "0"
      }
    },
    "claude-bridge": {
      "command": "bun",
      "args": ["${CLAUDE_PLUGIN_ROOT}/hooks-handlers/bridge-mcp.ts"]
    },
    "ovh-domain": {
      "type": "http",
      "url": "https://mcp.eu.ovhcloud.com/mcp/v1_domain"
    },
    "ovh-vps": {
      "type": "http",
      "url": "https://mcp.eu.ovhcloud.com/mcp/v1_vps"
    },
    "ovh-ip": {
      "type": "http",
      "url": "https://mcp.eu.ovhcloud.com/mcp/v1_ip"
    },
    "ovh-cloud": {
      "type": "http",
      "url": "https://mcp.eu.ovhcloud.com/mcp/v1_cloud"
    },
    "ovh-cloud-instance": {
      "type": "http",
      "url": "https://mcp.eu.ovhcloud.com/mcp/v1_cloud_instance"
    },
    "hostinger-vps": {
      "command": "bun",
      "args": [
        "${USERPROFILE}/.bun/install/global/node_modules/@hostinger/mcp/src/servers/vps.js"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    },
    "hostinger-dns": {
      "command": "bun",
      "args": [
        "${USERPROFILE}/.bun/install/global/node_modules/@hostinger/mcp/src/servers/dns.js"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    },
    "hostinger-domains": {
      "command": "bun",
      "args": [
        "${USERPROFILE}/.bun/install/global/node_modules/@hostinger/mcp/src/servers/domains.js"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    },
    "hostinger-billing": {
      "command": "bun",
      "args": [
        "${USERPROFILE}/.bun/install/global/node_modules/@hostinger/mcp/src/servers/billing.js"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    }
  }
}
