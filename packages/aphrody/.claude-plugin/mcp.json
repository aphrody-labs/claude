{
  "mcpServers": {
    "relay": {
      "command": "bun",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/hooks-handlers/relay-stdio.ts"
      ],
      "env": {
        "RELAY_HUB": "0"
      }
    },
    "claude-bridge": {
      "command": "bun",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/hooks-handlers/bridge-mcp.ts"
      ]
    },
    "ovh-domain": {
      "type": "http",
      "url": "https://mcp.eu.ovhcloud.com/mcp/v1_domain"
    },
    "ovh-vps": {
      "type": "http",
      "url": "https://mcp.eu.ovhcloud.com/mcp/v1_vps"
    },
    "ovh-ip": {
      "type": "http",
      "url": "https://mcp.eu.ovhcloud.com/mcp/v1_ip"
    },
    "ovh-cloud": {
      "type": "http",
      "url": "https://mcp.eu.ovhcloud.com/mcp/v1_cloud"
    },
    "ovh-cloud-instance": {
      "type": "http",
      "url": "https://mcp.eu.ovhcloud.com/mcp/v1_cloud_instance"
    },
    "hostinger": {
      "command": "bun",
      "args": [
        "${USERPROFILE}/.bun/install/global/node_modules/@hostinger/mcp/src/servers/all.js"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    },
    "memory": {
      "command": "bun",
      "args": [
        "--no-install",
        "--no-env-file",
        "${CLAUDE_PLUGIN_ROOT}/hooks-handlers/memory-mcp.ts"
      ]
    }
  }
}
