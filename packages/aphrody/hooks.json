{
  "aphrody": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bun --no-install --no-env-file \"./hooks-handlers/config-sync.ts\" pull agy",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "bun --no-install --no-env-file \"./hooks-handlers/learn.ts\" capture agy",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-install --no-env-file \"./hooks-handlers/auto-background.ts\" agy",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-install --no-env-file \"./hooks-handlers/typecheck.ts\" agy",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-install --no-env-file \"./hooks-handlers/learn.ts\" capture agy",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bun --no-install --no-env-file \"./hooks-handlers/config-sync.ts\" push agy",
        "timeout": 10
      }
    ]
  }
}
