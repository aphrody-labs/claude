{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-install --no-env-file \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.ts\" claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-install --no-env-file \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use.ts\" claude",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
