# Whitelist: ignore runtime state, secrets, transcripts, and caches; track only portable config.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/CLAUDE.md
!/settings.json
!/gitconfig
!/package.json
!/bun.lock
!/tsconfig.json
!/bunfig.toml
!/.claude-plugin/
!/.claude/
/.claude/settings.local.json
!/packages/
!/scripts/
!/skills/
!/docs/
!/agent.toml
!/paths.allow
!/naming.toml
!/toolchain.toml
# Project memory and transcripts live in the private claude-local repository (nested at projects/), never here.
node_modules/
packages/**/node_modules/
