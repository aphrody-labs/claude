# Whitelist: ignore runtime state, secrets, transcripts, and caches; track only portable config.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CLAUDE.md
!/settings.json
!/gitconfig
!/package.json
!/bun.lock
!/tsconfig.json
!/.claude-plugin/
!/.claude/
/.claude/settings.local.json
!/packages/
!/gemini/
!/scripts/
# Per-project auto-memory only, not session transcripts.
!/projects/
/projects/*/*
!/projects/*/memory/
node_modules/
packages/**/node_modules/
