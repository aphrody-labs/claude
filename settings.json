{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
    "BASH_MAX_OUTPUT_LENGTH": "150000",
    "MAX_MCP_OUTPUT_TOKENS": "100000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "100000",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    "ENABLE_TOOL_SEARCH": "true",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_ENABLE_FINE_GRAINED_TOOL_STREAMING": "1",
    "CLAUDE_CODE_ENABLE_CFC": "1",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "auto",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "5"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "AskUserQuestion",
      "EnterPlanMode"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "sonnet",
  "fallbackModel": [
    "sonnet",
    "haiku"
  ],
  "enabledPlugins": {
    "cc-plugin-privacy@builtin": false,
    "frontend-design@anthropic-plugin-directory": true,
    "feature-dev@anthropic-plugin-directory": true,
    "humanizer-blader@anthropic-plugin-directory": true,
    "pr-review-toolkit@anthropic-plugin-directory": true,
    "plugin-management@anthropic-plugin-directory": true,
    "claude-code-setup@anthropic-plugin-directory": true,
    "claude-md-management@anthropic-plugin-directory": true,
    "cloudflare@anthropic-plugin-directory": true,
    "vercel@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true,
    "github@anthropic-plugin-directory": true,
    "hostinger@claude-plugins-official": true,
    "code-modernization@anthropic-plugin-directory": true,
    "code-simplifier@anthropic-plugin-directory": true,
    "plugin-dev@anthropic-plugin-directory": true,
    "watch-video@anthropic-plugin-directory": true,
    "hyperframes@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "outputStyle": "Autonome",
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "useAutoModeDuringPlan": true
}
