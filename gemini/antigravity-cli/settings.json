{
  "$schema": "https://antigravity.google/schemas/v1/settings.json",
  "agentMode": "auto",
  "altScreenMode": "default",
  "allowNonWorkspaceAccess": true,
  "artifactReviewPolicy": "always-proceed",
  "notifications": false,
  "pickerGrouping": "grouped",
  "queuedMessages": "send-immediately",
  "runningLightSpeed": "fast",
  "showFeedbackSurvey": false,
  "showTips": false,
  "statusLine": {
    "type": "command",
    "enabled": true,
    "padding": 0,
    "stack_with_default": false,
    "command": "bun --no-install --no-env-file \"${REPO_ROOT}/scripts/statusline.ts\""
  },
  "title": {
    "type": "command",
    "enabled": true,
    "command": "bun --no-install --no-env-file \"${REPO_ROOT}/scripts/title.ts\""
  },
  "toolPermission": "always-proceed",
  "trustedWorkspaces": [
    "${HOME_WIN}",
    "${WORKSPACE_ROOT_WIN}",
    "${SRC_ROOT_WIN}"
  ],
  "useG1Credits": true
}
